# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./ai_mirror.db
# PostgreSQL Example: DATABASE_URL=postgresql://aimirror:aimirror_password@localhost:5432/ai_mirror_db

# Security & JWT Token Encryption
SECRET_KEY=super-secret-key-ai-mirror-2026-production

# CORS Allowed Origins for Production Frontend (Comma-separated)
# Local: http://localhost:3000,http://127.0.0.1:3000
# Production: https://your-netlify-site.netlify.app
BACKEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Virtual Try-On Provider & API Keys
VIRTUAL_TRYON_PROVIDER=mock
VIRTUAL_TRYON_API_KEY=
AI_PROVIDER_API_KEY=

# Retailer Integration Credentials (Optional environment configs)
MYNTRA_API_KEY=
MYNTRA_API_SECRET=
NYKAA_API_KEY=
NYKAA_API_SECRET=
AJIO_API_KEY=
AMAZON_API_KEY=
